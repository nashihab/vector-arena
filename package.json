{
  "name": "vector-arena",
  "version": "0.7.4",
  "private": true,
  "description": "A browser-based real-time 3D multiplayer first-person arena shooter.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config vite.config.js --host 0.0.0.0",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  }
}
